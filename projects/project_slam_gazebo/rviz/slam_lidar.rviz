Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Value: true
      Cell Size: 5
      Line Style:
        Value: Lines
      Normal Cell Count: 0
      Plane: XY
      Plane Cell Count: 12
    - Class: rviz_default_plugins/TF
      Name: TF
      Value: false
      Show Arrows: false
      Show Axes: true
      Show Names: false
      Marker Scale: 0.5
      Frame Timeout: 15
    - Class: rviz_default_plugins/PointCloud2
      Name: LiDAR Raw
      Value: true
      Topic:
        Value: /drone0/sensor_measurements/lidar_0/points
        Depth: 5
        Durability Policy: Volatile
        Reliability Policy: Best Effort
      Size (Pixels): 2
      Style: Points
      Color Transformer: FlatColor
      Color: 255; 100; 100
      Use Fixed Frame: true
      Decay Time: 0
    - Class: rviz_default_plugins/PointCloud2
      Name: SLAM Map Cloud
      Value: true
      Topic:
        Value: /drone0/slam/map_cloud
        Depth: 1
        Durability Policy: Volatile
        Reliability Policy: Reliable
      Size (Pixels): 3
      Style: Points
      Color Transformer: AxisColor
      Axis: Z
      Use Fixed Frame: true
      Decay Time: 0
    - Class: rviz_default_plugins/Odometry
      Name: SLAM Odometry
      Value: true
      Topic:
        Value: /drone0/slam/odom
        Depth: 5
        Durability Policy: Volatile
        Reliability Policy: Reliable
      Position Tolerance: 0.1
      Angle Tolerance: 0.1
      Keep: 100
      Shape:
        Value: Arrow
        Arrow Length: 0.3
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: drone0/map
    Frame Rate: 30
  Tools:
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/FocusCamera
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 25
      Focal Point:
        X: 0
        Y: 0
        Z: 0
      Pitch: 0.7
      Yaw: 0.8
      Name: Current View
Window Geometry:
  Width: 1200
  Height: 800
  Displays:
    collapsed: false
  Views:
    collapsed: true
